<section id="main-content" class="page-intro">
  <p class="eyebrow">Documentation</p>
  <h1>{{category.name}}</h1>
  {{#if category.description}}<p>{{category.description}}</p>{{/if}}
</section>

<div class="section-grid">
  {{#each sections}}
    <section class="section-card">
      <h2>{{name}}</h2>
      {{#if description}}<p>{{description}}</p>{{/if}}
      {{#if articles}}
        <ul>
          {{#each (slice articles 0 4)}}
            <li>
              <a href="{{url}}">
                <span>{{title}}</span>
                <svg class="lucide-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              </a>
            </li>
          {{/each}}
        </ul>
        {{#if more_articles}}<a class="quick-link" href="{{url}}">View all {{article_count}} articles</a>{{/if}}
      {{/if}}
    </section>
  {{/each}}
</div>

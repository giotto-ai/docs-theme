<div class="article-layout">
  <article id="main-content">
    <header class="article-header">
      <p class="eyebrow">Documentation · {{section.name}}</p>
      <h1 class="article-title">{{article.title}}</h1>
      <p class="article-summary">{{excerpt article.body characters=240}}</p>
    </header>

    <div class="article-body">{{article.body}}</div>

    {{#if (compare article.content_tags.length ">" 0)}}
      <section class="content-tags">
        <p>{{t 'content_tags_label'}}</p>
        <ul class="content-tag-list">
          {{#each article.content_tags}}
            <li class="content-tag-item">
              {{#link "search_result" content_tag_id=id}}{{name}}{{/link}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    {{#if attachments}}
      <div class="article-attachments">
        <ul class="attachments">
          {{#each attachments}}
            <li class="attachment-item">
              <a href="{{url}}" target="_blank" rel="noreferrer noopener">{{name}}</a>
              <span class="attachment-meta">{{size}}</span>
            </li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <footer class="article-footer">
      {{#if settings.show_related_articles}}
        {{related_articles}}
      {{/if}}

      {{#if settings.show_article_sharing}}
        <section class="article-share" aria-labelledby="share-title">
          <div class="article-footer-heading">
            <span class="footer-icon"><svg class="lucide-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4"></path><path d="m15.4 6.5-6.8 4"></path></svg></span>
            <h2 id="share-title">Share this article</h2>
          </div>
          <div class="article-share-links">
            <a data-share-network="facebook" href="#" target="_blank" rel="noreferrer noopener" aria-label="Share on Facebook"><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.42c0-3.026 1.791-4.7 4.533-4.7 1.312 0 2.686.236 2.686.236v2.953h-1.514c-1.492 0-1.956.93-1.956 1.884v2.28h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"></path></svg><span>Facebook</span></a>
            <a data-share-network="x" href="#" target="_blank" rel="noreferrer noopener" aria-label="Share on X"><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"></path></svg><span>X</span></a>
            <a data-share-network="linkedin" href="#" target="_blank" rel="noreferrer noopener" aria-label="Share on LinkedIn"><svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V8.999h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.287ZM5.337 7.433a2.062 2.062 0 1 1 0-4.123 2.062 2.062 0 0 1 0 4.123ZM3.56 20.452h3.56V8.999H3.56v11.453ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0Z"></path></svg><span>LinkedIn</span></a>
            <button class="footer-link-button" type="button" data-action="copy-article-link"><svg class="lucide-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><span>Copy link</span></button>
          </div>
        </section>
      {{/if}}
    </footer>
  </article>

  <aside class="article-toc" aria-label="On this page">
    <div class="toc-label">On this page</div>
    <nav id="article-toc-links"></nav>
  </aside>
</div>

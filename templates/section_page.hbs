<section id="main-content" class="page-intro">
  <p class="eyebrow">{{section.category.name}}</p>
  <h1>{{section.name}}</h1>
  {{#if section.description}}<p>{{section.description}}</p>{{/if}}
</section>

<div class="search-page">
  <div class="result-list">
    {{#each section.articles}}
      <a class="result-item" href="{{url}}">
        <h2>{{title}}</h2>
        <small>{{../section.name}}</small>
        <p>{{excerpt body}}</p>
      </a>
    {{/each}}
  </div>
  {{pagination "section.articles"}}
</div>

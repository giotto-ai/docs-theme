<h1 class="visibility-hidden">{{help_center.name}}</h1>

<section id="main-content" class="hero">
  <p class="eyebrow">Giotto documentation</p>
  <h1>Intelligence you control.</h1>
  <p>Build, deploy, and operate Giotto across cloud, API, on-premise infrastructure, and the ideas behind modern reasoning systems.</p>
  <div class="hero-search">
    <svg class="hero-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
    {{search submit=false instant=settings.instant_search class='search search-full'}}
  </div>
</section>

<section class="home-explore" aria-labelledby="explore-docs-title">
  <div class="section-heading">
    <h2 id="explore-docs-title">Explore the docs</h2>
  </div>
  <div class="category-grid">
    {{#each categories}}
      <a class="category-card" href="{{url}}">
        <span class="card-eyebrow">Documentation</span>
        <h3>{{name}}</h3>
        <p>{{excerpt description}}</p>
        <span class="card-footer"><span>{{article_count}} articles</span><svg class="lucide-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
      </a>
    {{/each}}
  </div>

  {{#if promoted_articles}}
    <div class="quick-links" aria-label="Featured articles">
      {{#each promoted_articles}}
        <a class="quick-link" href="{{url}}">{{title}}</a>
      {{/each}}
    </div>
  {{/if}}
</section>

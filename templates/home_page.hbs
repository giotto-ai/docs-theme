<div class="content-skeleton content-skeleton-home" aria-hidden="true">
  <div class="skeleton-home-hero">
    <span class="skeleton-line skeleton-home-title"></span>
    <span class="skeleton-line skeleton-home-title skeleton-home-title-short"></span>
    <span class="skeleton-line skeleton-home-summary"></span>
    <span class="skeleton-line skeleton-home-summary skeleton-home-summary-short"></span>
  </div>
  <div class="skeleton-home-explore">
    <span class="skeleton-line skeleton-home-explore-title"></span>
    <div class="skeleton-home-card-grid">
      <div class="skeleton-home-card"><span class="skeleton-line skeleton-home-card-badge"></span><span class="skeleton-line skeleton-home-card-title"></span><span class="skeleton-line skeleton-home-card-copy"></span><span class="skeleton-line skeleton-home-card-copy skeleton-home-card-copy-short"></span><span class="skeleton-line skeleton-home-card-footer"></span></div>
      <div class="skeleton-home-card"><span class="skeleton-line skeleton-home-card-badge"></span><span class="skeleton-line skeleton-home-card-title"></span><span class="skeleton-line skeleton-home-card-copy"></span><span class="skeleton-line skeleton-home-card-copy skeleton-home-card-copy-short"></span><span class="skeleton-line skeleton-home-card-footer"></span></div>
      <div class="skeleton-home-card"><span class="skeleton-line skeleton-home-card-badge"></span><span class="skeleton-line skeleton-home-card-title"></span><span class="skeleton-line skeleton-home-card-copy"></span><span class="skeleton-line skeleton-home-card-copy skeleton-home-card-copy-short"></span><span class="skeleton-line skeleton-home-card-footer"></span></div>
      <div class="skeleton-home-card"><span class="skeleton-line skeleton-home-card-badge"></span><span class="skeleton-line skeleton-home-card-title"></span><span class="skeleton-line skeleton-home-card-copy"></span><span class="skeleton-line skeleton-home-card-copy skeleton-home-card-copy-short"></span><span class="skeleton-line skeleton-home-card-footer"></span></div>
    </div>
  </div>
</div>

<section id="main-content" class="hero">
  <h1>Intelligence you control.</h1>
  <p>Build, deploy, and operate Giotto across cloud, API, on-premise infrastructure, and the ideas behind modern reasoning systems.</p>
</section>

<section class="home-explore" aria-labelledby="explore-docs-title">
  <div class="section-heading">
    <h2 id="explore-docs-title">Explore the docs</h2>
  </div>
  <div class="category-grid">
    {{#each categories}}
      <a class="category-card" data-category-id="{{id}}" href="{{url}}">
        <span class="card-eyebrow badge badge-secondary">Documentation</span>
        <h3>{{name}}</h3>
        <p>{{excerpt description}}</p>
        <span class="card-footer"><span class="category-card-count">— articles</span><svg class="lucide-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
      </a>
    {{/each}}
  </div>

  {{#if promoted_articles}}
    <div class="quick-links" aria-label="Featured articles">
      {{#each promoted_articles}}
        <a class="quick-link" href="{{url}}">{{title}}</a>
      {{/each}}
    </div>
  {{/if}}
</section>

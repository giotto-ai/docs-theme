<section id="main-content" class="search-page">
  <p class="eyebrow">Search</p>
  <h1>Search results</h1>

  <form class="search-page-form" action="{{page_path 'help_center'}}/search" method="get" role="search">
    <label class="sr-only" for="page-search-input">Search Giotto Docs</label>
    <input id="page-search-input" name="query" type="search" value="{{query}}" placeholder="Search Giotto Docs" autocomplete="off" />
  </form>

  {{generative_answers}}

  {{#if results}}
    <p class="search-result-count">{{t 'results' query=query count=results_count}}</p>
    <div class="result-list">
      {{#each results}}
        <a class="result-item" href="{{url}}"{{#if is_external}} target="_blank" rel="noreferrer noopener"{{/if}}>
          <h2>{{title}}</h2>
          <small>{{#if meta}}{{meta}}{{else}}{{type}}{{/if}}</small>
          <p>{{text}}</p>
        </a>
      {{/each}}
    </div>
  {{else}}
    <p class="empty-state">{{t 'no_results_unified_start_new_search'}}</p>
  {{/if}}

  {{pagination}}
</section>

<a class="skip-navigation" tabindex="1" href="#main-content">{{t 'skip_navigation' }}</a>
<script>document.documentElement.classList.add('giotto-loading');</script>

<div class="app-shell" id="app-shell" data-locale="{{help_center.locale}}" data-help-center-path="{{page_path 'help_center'}}">
  <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
    <div class="sidebar-topline">
      <a class="brand" href="{{page_path 'help_center'}}" aria-label="{{t 'home_page' name=help_center.name}}">
        <img class="brand-logo" src="{{asset 'giotto-wordmark.svg'}}" alt="Giotto" />
        <span class="brand-docs">Docs</span>
      </a>
      <button class="icon-button sidebar-close" data-action="close-sidebar" aria-label="Close navigation">
        <svg class="lucide-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
    <nav id="sidebar-nav" class="sidebar-nav" data-slot="sidebar-menu" aria-busy="true">
      <div class="sidebar-skeleton" aria-hidden="true">
        <span class="skeleton-line skeleton-sidebar-home"></span>
        <span class="skeleton-line skeleton-sidebar-category"></span>
        <span class="skeleton-line skeleton-sidebar-section"></span>
        <span class="skeleton-line skeleton-sidebar-article"></span>
        <span class="skeleton-line skeleton-sidebar-section"></span>
        <span class="skeleton-line skeleton-sidebar-section"></span>
        <span class="skeleton-line skeleton-sidebar-category"></span>
        <span class="skeleton-line skeleton-sidebar-section"></span>
      </div>
    </nav>
  </aside>
  <div class="sidebar-scrim" data-action="close-sidebar"></div>

  <div class="page-shell">
    <header class="topbar">
      <button class="icon-button menu-trigger" data-action="open-sidebar" aria-label="Open navigation">
        <svg class="lucide-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
      </button>
      <button class="topbar-search" data-action="open-search" type="button" aria-label="Search documentation">
        <svg class="lucide-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <span class="topbar-search-label">Search docs</span>
        <kbd class="shortcut">⌘ K</kbd>
      </button>
      <div class="topbar-actions">
        {{#unless signed_in}}
          {{#link "sign_in" class="button button-ghost topbar-auth-button" role="link"}}{{t 'sign_in'}}{{/link}}
        {{/unless}}
        {{link 'new_request' class='button button-primary topbar-auth-button'}}
      </div>
    </header>

    <div class="search-dialog" id="search-dialog" hidden>
      <div class="dialog-backdrop" data-action="close-search"></div>
      <section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
        <div class="search-panel-header">
          <h2 id="search-title">Search Giotto Docs</h2>
          <button class="icon-button" data-action="close-search" type="button" aria-label="Close search">
            <svg class="lucide-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
          </button>
        </div>
        <form id="global-search-form" class="search-panel-form" action="{{page_path 'help_center'}}/search" method="get">
          <label class="visibility-hidden" for="dialog-search-input">Search Giotto Docs</label>
          <input id="dialog-search-input" name="query" type="search" placeholder="Search articles, APIs, and tutorials" autocomplete="off" />
        </form>
        <div id="search-results" class="search-results" aria-live="polite"></div>
      </section>
    </div>

    <div class="main-content">
